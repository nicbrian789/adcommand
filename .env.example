# Salin ke .env.local dan isi nilainya. Jangan commit .env.local.

# Supabase (wajib untuk auth + data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cron (wajib di Vercel Production agar /api/cron/* bisa dijalankan)
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate_a_long_random_string

# Telegram alerts (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Assisten — enkripsi key BYOK per workspace (wajib jika Owner menyimpan key OpenAI/Claude di Settings)
AI_CREDENTIALS_SECRET=generate_a_long_random_string_16plus

# Fallback server-wide (opsional). Diutamakan: key workspace dari Settings (OpenAI atau Claude).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
