# Salin ke .env.local dan isi nilainya. Jangan commit .env.local.

# Supabase (wajib untuk auth + data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cron (wajib di Vercel Production agar /api/cron/* bisa dijalankan)
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate_a_long_random_string

# Telegram alerts (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
